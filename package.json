{
  "name": "@meddleware/wallet-adapter",
  "version": "0.0.1",
  "description": "Shared Sui wallet adapter for Meddleware Vue 3 apps: a module-singleton wallet-standard composable (connect/disconnect, personal-message signing, transaction executor) so multiple tool views can share one wallet connection.",
  "author": "Meddleware <dev@meddleware.co.uk>",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/wallet-adapter.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@mysten/sui": ">=2.17.0 <3",
    "@mysten/wallet-standard": ">=0.19.0 <1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@mysten/sui": "^2.28.0",
    "@mysten/wallet-standard": "^0.20.0",
    "@types/node": "~24.12.2",
    "typescript": "~6.0.0",
    "vitest": "~2.1.9",
    "vue": "^3.5.40",
    "vue-tsc": "~3.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
