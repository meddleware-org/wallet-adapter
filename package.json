{
  "name": "@meddleware/wallet-adapter",
  "version": "0.0.16",
  "description": "Shared Sui wallet adapter for Meddleware Vue 3 apps: a module-singleton wallet-standard composable (connect/disconnect, personal-message signing, transaction executor) so multiple tool views can share one wallet connection.",
  "author": "Meddleware <dev@meddleware.co.uk>",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/wallet-adapter.git"
  },
  "type": "module",
  "sideEffects": [
    "*.vue"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "lint:js": "eslint .",
    "lint": "npm run lint:css && npm run lint:js && npm run lint:html",
    "lint:html": "html-validate \"src/**/*.vue\""
  },
  "peerDependencies": {
    "@meddleware/ui": "^0.1.31",
    "@mysten/sui": "^2.33.1",
    "@mysten/wallet-standard": ">=0.21.0 <0.22",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@meddleware/ui": "^0.1.31",
    "@mysten/sui": "^2.33.1",
    "@mysten/wallet-standard": "^0.21.0",
    "@types/node": "~24.12.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "html-validate": "^11.16.0",
    "html-validate-vue": "^9.3.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.0",
    "vitest": "~5.0.2",
    "vitest-axe": "^0.1.0",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "~3.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
